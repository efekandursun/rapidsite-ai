# FieldFlow AI - Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# OPENROUTER (LLM - Required)
# Get your key from: https://openrouter.ai/keys
# =============================================================================
OPENROUTER_API_KEY=your_openrouter_key_here

# =============================================================================
# OPENAI (For Whisper STT - Required for voice messages)
# Get your key from: https://platform.openai.com/api-keys
# =============================================================================
OPENAI_API_KEY=your_openai_key_here

# =============================================================================
# TWILIO (WhatsApp - Required for WhatsApp integration)
# Get credentials from: https://console.twilio.com
# =============================================================================
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_WHATSAPP_NUMBER=+14155238886

# =============================================================================
# PROCORE (ERP Integration - Optional, for Phase 2)
# Register app at: https://developers.procore.com
# =============================================================================
PROCORE_CLIENT_ID=your_procore_client_id
PROCORE_CLIENT_SECRET=your_procore_client_secret
PROCORE_ACCESS_TOKEN=your_access_token
PROCORE_COMPANY_ID=your_company_id

# =============================================================================
# DATABASE
# =============================================================================
DATABASE_PATH=./data/fieldflow.db

# =============================================================================
# EMAIL (Required for email verification)
# Render free web services block outbound SMTP ports. Use an HTTPS API provider
# such as SendGrid or Resend in production.
# =============================================================================
EMAIL_PROVIDER=sendgrid
EMAIL_FROM=your-verified-sender@example.com
EMAIL_FROM_NAME=RapidSite AI
SENDGRID_API_KEY=your_sendgrid_api_key
# RESEND_API_KEY=your_resend_api_key

# SMTP is still supported for local development or paid hosts with SMTP egress.
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your@gmail.com
SMTP_PASSWORD=your_gmail_app_password
# Use SMTP_USERNAME or a verified Gmail/Workspace "send mail as" alias.
SMTP_FROM_EMAIL=your@gmail.com

# =============================================================================
# SECURITY
# =============================================================================
PASSWORD_SALT=change-this-to-a-random-string

# =============================================================================
# FLASK
# =============================================================================
FLASK_ENV=development
FLASK_SECRET_KEY=change-this-to-a-random-string-in-production
PORT=5000

# =============================================================================
# CSV EXPORT (Fallback when no ERP configured)
# =============================================================================
CSV_EXPORT_PATH=./exports
